<?xml version="1.0"?>
<!-- Victim lying on the floor, about 1.7 m long and 0.25 m high, head towards +x. Origin on the floor. -->
<sdf version="1.9">
  <model name="victim_lying">
    <static>true</static>
    <link name="body">
      <collision name="body_col"><pose>0 0 0.11 0 0 0</pose><geometry><box><size>1.45 0.42 0.22</size></box></geometry></collision>
      <visual name="body_vis"><pose>0 0 0.11 0 0 0</pose><geometry><box><size>1.45 0.42 0.22</size></box></geometry><material><ambient>1 0.45 0 1</ambient><diffuse>1 0.45 0 1</diffuse></material></visual>
      <collision name="head_col"><pose>0.84 0 0.12 0 0 0</pose><geometry><sphere><radius>0.11</radius></sphere></geometry></collision>
      <visual name="head_vis"><pose>0.84 0 0.12 0 0 0</pose><geometry><sphere><radius>0.11</radius></sphere></geometry><material><ambient>0.85 0.65 0.5 1</ambient><diffuse>0.85 0.65 0.5 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
