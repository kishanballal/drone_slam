<?xml version="1.0" encoding="UTF-8"?>
<!-- M2a drone + ONE low-memory RGB-D camera for visual SLAM.
     Memory savers (Gazebo cameras grew memory under WSL):
       * 320x240 instead of 640x480+  -> 4x fewer pixels per frame
       * 5 Hz instead of 30 Hz        -> 6x fewer frames
       * one rgbd_camera sensor (colour + depth in one render pass set)
       * Gazebo only renders a camera while something subscribes to it, so the
         camera costs nothing until camera_guard starts its bridge, and stops
         costing again the moment camera_guard stops it. -->
<sdf version="1.9">
  <model name="x500_lidar_3d_ev_cam">
    <include merge="true">
      <uri>x500_lidar_3d_ev</uri>
    </include>

    <link name="camera_link">
      <pose relative_to="base_link">0.15 0 0.05 0 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.03 0.09 0.025</size></box></geometry>
      </visual>
      <sensor name="rgbd" type="rgbd_camera">
        <gz_frame_id>camera_optical</gz_frame_id>
        <topic>camera</topic>
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>320</width><height>240</height><format>R8G8B8</format></image>
          <clip><near>0.2</near><far>8.0</far></clip>
          <depth_camera><clip><near>0.2</near><far>8.0</far></clip></depth_camera>
        </camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
  </model>
</sdf>
