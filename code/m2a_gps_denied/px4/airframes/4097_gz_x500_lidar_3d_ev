#!/bin/sh
#
# @name Gazebo x500 lidar 3d, GPS-denied (laser odometry as external vision)
#
# @type Quadrotor
#
# Same drone as 4098 (M0/M1). GPS is removed and EKF2 fuses rf2o laser
# odometry sent on /fmu/in/vehicle_visual_odometry. Height from barometer.

PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500_lidar_3d_ev}

. ${R}etc/init.d-posix/airframes/4098_gz_x500_lidar_3d

echo "M2a: GPS disabled, EKF2 uses laser odometry (external vision)"

# --- no GPS at all ---
param set-default SYS_HAS_GPS 0
param set-default SIM_GPS_USED 0
param set-default EKF2_GPS_CTRL 0

# --- height: barometer (PX4 default is 1 = GPS, which would never come) ---
param set-default EKF2_HGT_REF 0
param set-default EKF2_BARO_CTRL 1

# --- external vision: bits 0 horiz pos (1) + 2 velocity (4) + 3 yaw (8) = 13 ---
param set-default EKF2_EV_CTRL 13
param set-default EKF2_EV_NOISE_MD 0
param set-default EKF2_EVP_NOISE 0.05
param set-default EKF2_EVV_NOISE 0.1
param set-default EKF2_EVA_NOISE 0.05
param set-default EKF2_EV_DELAY 0
param set-default EKF2_EV_QMIN 0

# --- allow arming without a GPS fix ---
param set-default COM_ARM_WO_GPS 1
